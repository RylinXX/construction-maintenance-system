# ─────────────────────────────────────────────────────────────────────────────
# 营力特数字化系统 (YLT Digital) - Docker 环境变量配置
# 使用说明：复制本文件为 .env，并根据实际部署修改以下参数
# ─────────────────────────────────────────────────────────────────────────────

# 必填：Flask 会话签名密钥（必须替换为强随机字符串，例如执行: python -c "import secrets; print(secrets.token_urlsafe(48))"）
CAM_SECRET_KEY=change_this_to_a_secure_random_key_123456789

# 首次部署：超级管理员初始账号与密码哈希
# 密码哈希可通过执行生成：python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('YourPasswordHere'))"
CAM_ADMIN_USERNAME=admin
CAM_ADMIN_PASSWORD_HASH=

# 安全与功能开关
CAM_AUTH_REQUIRED=1
CAM_CSRF_ENABLED=1
CAM_SESSION_COOKIE_SECURE=0

# 火山方舟 OCR 配置（可选，发票/证件识别）
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-0-pro-260215
