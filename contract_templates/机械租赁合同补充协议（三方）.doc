></w:r><w:r><w:rPr><w:rFonts w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>），现甲乙丙三方</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="宋体" w:h-ansi="宋体" w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>经友</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="宋体" w:h-ansi="宋体" w:hint="default"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>好</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="宋体" w:h-ansi="宋体" w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>协商，就原合</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="宋体" w:h-ansi="宋体" w:hint="default"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>同的</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="宋体" w:h-ansi="宋体" w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>履行达成如下补充协议，供三</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="宋体" w:h-ansi="宋体" w:hint="default"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>方</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="宋体" w:h-ansi="宋体" w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>共同遵守执行：</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:line="360" w:line-rule="auto"/><w:ind w:first-line="560" w:first-line-chars="200"/><w:rPr><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>一、三方一致同意，原合</w:t></w:r><w:r><w:rPr><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>同</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>的需方</w:t></w:r><w:r><w:rPr><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>由甲方变更为丙方</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>，即甲方将原合</w:t></w:r><w:r><w:rPr><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>同中</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>的所</w:t></w:r><w:r><w:rPr><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>有</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>权利义务转移给丙方（本协议第</w:t></w:r><w:r><w:rPr><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>二条另有约定的除外</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>）；如出现机械质量问题、迟延付款等任何违约情形</w:t></w:r><w:r><w:rPr><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>时</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>，由乙方和丙方按原合</w:t></w:r><w:r><w:rPr><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>同</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>及</w:t></w:r><w:r><w:rPr><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>本</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>协议约定处理，与甲方无关，</w:t></w:r><w:r><w:rPr><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>甲方不承担</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>任何</w:t></w:r><w:r><w:rPr><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>违约责任</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>。丙方根据</w:t></w:r><w:permStart w:id="16" w:edGrp="everyone"/><w:r><w:rPr><w:rFonts w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/><w:u w:val="single"/></w:rPr><w:t>《××龙光××项目××期建设工程施工分包合同》</w:t></w:r><w:permEnd w:id="16"/><w:r><w:rPr><w:rFonts w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>对甲方承担相应义务。</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:line="360" w:line-rule="auto"/><w:ind w:first-line="560" w:first-line-chars="200"/><w:rPr><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>二、原合</w:t></w:r><w:r><w:rPr><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>同</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>的主体变更后，甲方仅</w:t></w:r><aml:annotation aml:id="0" aml:author="B01K04.许文晋" aml:createdate="2019-03-12T09:15:00Z" w:type="Word.Insertion"><aml:content><w:r><w:rPr><w:rFonts w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>依据</w:t></w:r></aml:content></aml:annotation><aml:annotation aml:id="1" aml:author="B01K04.许文晋" aml:createdate="2019-03-12T09:15:00Z" w:type="Word.Insertion"><aml:content><w:r><w:rPr><w:rFonts w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/><w:u w:val="single"/></w:rPr><w:t>《××龙光××项目××期建设工程施工分包合同》</w:t></w:r></aml:content></aml:annotation><aml:annotation aml:id="2" aml:author="B01K04.许文晋" aml:createdate="2019-03-12T09:15:00Z" w:type="Word.Insertion"><aml:content><w:r><w:rPr><w:sz w:val="28"/><w:sz-cs w:val="28"/><w:u w:val="single"/></w:rPr><w:t>的约定</w:t></w:r></aml:content></aml:annotation><w:r><w:rPr><w:rFonts w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>按照丙方的指示向乙方代为支付机械租赁费用</w:t></w:r><aml:annotation aml:id="3" aml:author="B01K04.许文晋" aml:createdate="2019-03-12T09:15:00Z" w:type="Word.Insertion"><aml:content><w:r><w:rPr><w:rFonts w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>，</w:t></w:r></aml:content></aml:annotation><aml:annotation aml:id="4" aml:author="B01K04.许文晋" aml:createdate="2019-03-12T09:17:00Z" w:type="Word.Insertion"><aml:content><w:r><w:rPr><w:rFonts w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>乙方</w:t></w:r></aml:content></aml:annotation><aml:annotation aml:id="5" aml:author="B01K04.许文晋" aml:createdate="2019-03-12T09:16:00Z" w:type="Word.Insertion"><aml:content><w:r><w:rPr><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>不得直接向甲方主张权利。</w:t></w:r></aml:content></aml:annotation><w:r><w:rPr><w:rFonts w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>甲方支付给</w:t></w:r><w:r><w:rPr><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>乙方</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>的机械租赁费用由甲方在应付给丙方的工程款中直接扣除，</w:t></w:r><aml:annotation aml:id="6" aml:author="B01K04.许文晋" aml:createdate="2019-03-12T09:17:00Z" w:type="Word.Insertion"><aml:content><w:r><w:rPr><w:rFonts w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>如按照《××龙光××项目××期建设工程施工分包合同》应付丙方的工程款不足以抵扣乙方机械</w:t></w:r></aml:content></aml:annotation><aml:annotation aml:id="7" aml:author="B01K04.许文晋" aml:createdate="2019-03-12T09:17:00Z" w:type="Word.Insertion"><aml:content><w:r><w:rPr><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>租赁费用</w:t></w:r></aml:content></aml:annotation><aml:annotation aml:id="8" aml:author="B01K04.许文晋" aml:createdate="2019-03-12T09:17:00Z" w:type="Word.Insertion"><aml:content><w:r><w:rPr><w:rFonts w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>的，甲方有权停止向乙方代付机械租赁费用。</w:t></w:r></aml:content></aml:annotation><w:r><w:rPr><w:rFonts w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>乙方在甲方付款前需开具抬头单位为甲方的足额、合法有效发票。</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:line="360" w:line-rule="auto"/><w:ind w:first-line="560" w:first-line-chars="200"/><w:rPr><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>三</w:t></w:r><w:r><w:rPr><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>、本协议作为原合同的补充，本协议与原合同有冲突的，按本协议约定执行，本协议未</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>约定</w:t></w:r><w:r><w:rPr><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>的其它内容按原合同执行。</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:line="360" w:line-rule="auto"/><w:ind w:first-line="560" w:first-line-chars="200"/><w:rPr><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>四、本协议一式</w:t></w:r><w:permStart w:id="17" w:edGrp="everyone"/><w:r><w:rPr><w:rFonts w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>陆</w:t></w:r><w:permEnd w:id="17"/><w:r><w:rPr><w:rFonts w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>份，甲方执</w:t></w:r><w:permStart w:id="18" w:edGrp="everyone"/><w:r><w:rPr><w:rFonts w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>肆</w:t></w:r><w:permEnd w:id="18"/><w:r><w:rPr><w:rFonts w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>份，乙、丙方各执</w:t></w:r><w:permStart w:id="19" w:edGrp="everyone"/><w:r><w:rPr><w:rFonts w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>壹</w:t></w:r><w:permEnd w:id="19"/><w:r><w:rPr><w:rFonts w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>份，</w:t></w:r><w:r><w:rPr><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>均具有同等法律效力</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>。</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:line="360" w:line-rule="auto"/><w:ind w:first-line="560" w:first-line-chars="200"/><w:rPr><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>五、本协议自叁方签字</w:t></w:r><w:r><w:rPr><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>盖章之日起</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="fareast"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr><w:t>生效。</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:line="360" w:line-rule="auto"/><w:rPr><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr></w:pPr></w:p><w:p><w:pPr><w:spacing w:line="360" w:line-rule="auto"/><w:rPr><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr></w:pPr></w:p><w:p><w:pPr><w:spacing w:line="360" w:line-rule="auto"/><w:rPr><w:rFonts w:ascii="宋体" w:h-ansi="宋体" w:hint="default"/><w:color w:val="000000"/><w:sz w:val="28"/><w:sz-cs w:val="28"/></w:rPr></w:pPr></w:p><w:p><w:pPr><w:adjustRightInd w:val="off"/><w:snapToGrid w:val="off"/><w:spacing w:line="460" w: