            <wx:font wx:val="仿宋_GB2312" />
            <w:sz w:val="24" />
          </w:rPr>
          <w:t>进度款每月支付一次，由乙方附</w:t>
        </w:r>
        <w:r>
          <w:rPr>
            <w:rFonts w:ascii="仿宋_GB2312" w:fareast="仿宋_GB2312" w:h-ansi="宋体" w:hint="fareast" />
